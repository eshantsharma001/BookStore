<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/storefront.css">
    <title>Admin Login | Bookholic</title>
</head>
<body class="store-ui min-h-screen bg-[#f7f7ff] text-[#1e1b4b] antialiased">
    <%- include('includes/nav.ejs') %>
    <main class="relative flex min-h-[calc(100vh-72px)] items-center justify-center overflow-hidden px-6 py-20">
        <div class="absolute -left-32 -top-32 h-80 w-80 rounded-full bg-[#a78bfa]/15 blur-3xl"></div>
        <div class="absolute -bottom-32 -right-32 h-80 w-80 rounded-full bg-[#0f9f9a]/10 blur-3xl"></div>
        <div class="relative w-full max-w-md">
            <div class="overflow-hidden rounded-[1.75rem] border border-[#e4e1f5] bg-white shadow-2xl shadow-violet-950/10">
                <div class="h-1.5 bg-[#a78bfa]"></div>
                <div class="p-8 md:p-10">
                    <div class="mb-8 text-center">
                        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#1e1b4b] text-2xl text-[#a78bfa] shadow-lg shadow-violet-950/20">
                            🔐
                        </div>
                        <p class="mt-6 text-xs font-bold uppercase tracking-[4px] text-[#0f9f9a]">
                            Admin Panel
                        </p>
                        <h1 class="mt-2 text-3xl font-bold text-[#1e1b4b]">
                            Welcome Back
                        </h1>
                        <p class="mt-2 text-sm leading-6 text-gray-500">
                            Sign in to manage your bookstore collection.
                        </p>
                    </div>
                    <% if (authStatus === 'invalid') { %>
                        <p class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-700" role="alert">
                            The username or password is incorrect. Please try again.
                        </p>
                    <% } else if (authStatus === 'logged-out') { %>
                        <p class="mb-5 rounded-xl border border-green-200 bg-green-50 p-4 text-sm font-semibold text-green-800" role="status">
                            You have been logged out successfully.
                        </p>
                    <% } else if (authStatus === 'unauthorized') { %>
                        <p class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800" role="alert">
                            Please log in with an administrator account to continue.
                        </p>
                    <% } %>
                    <form action="/admin/login" method="POST">
                        <div class="mb-5">
                            <label for="username" class="mb-2 block text-sm font-semibold text-[#1e1b4b]">
                                Username
                            </label>
                            <input id="username" type="text" name="username" required autocomplete="username" placeholder="Enter your username"
                                class="w-full rounded-xl border border-[#dcd8f1] bg-[#fbfaff] px-4 py-3 text-sm text-[#1e1b4b] outline-none transition duration-300 placeholder:text-gray-400 focus:border-[#a78bfa] focus:bg-white focus:ring-4 focus:ring-[#a78bfa]/15">
                        </div>
                        <div class="mb-7">
                            <label for="password" class="mb-2 block text-sm font-semibold text-[#1e1b4b]">
                                Password
                            </label>
                            <input id="password" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password"
                                class="w-full rounded-xl border border-[#dcd8f1] bg-[#fbfaff] px-4 py-3 text-sm text-[#1e1b4b] outline-none transition duration-300 placeholder:text-gray-400 focus:border-[#a78bfa] focus:bg-white focus:ring-4 focus:ring-[#a78bfa]/15">
                        </div>
                        <button type="submit"
                            class="w-full rounded-xl bg-[#1e1b4b] py-3.5 font-bold text-white shadow-md shadow-violet-950/15 transition duration-300 hover:-translate-y-0.5 hover:bg-[#a78bfa] hover:text-[#171334] hover:shadow-xl">
                            Login to Admin Panel →
                        </button>
                    </form>
                    <div class="mt-7 border-t border-[#ebe9f7] pt-6 text-center">
                        <p class="text-xs text-gray-400">
                            Bookholic • Admin Access
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
    <footer class="bg-[#171334] px-6 py-7 text-center text-white">
        <h3 class="text-lg font-bold">
            <span class="text-[#a78bfa]">Bookholic</span>
        </h3>
        <p class="mt-2 text-sm text-white/40">
            Read. Learn. Grow. © Bookholic
        </p>
    </footer>
</body>
</html>
