<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Books | Bookholic</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/storefront.css">
</head>

<body class="store-ui min-h-screen bg-[#faf7f0] text-[#29251f] antialiased">

    <%- include('includes/nav.ejs') %>

    <% if (authStatus === 'logged-in') { %>
        <div class="mx-auto mt-5 max-w-6xl px-6">
            <p class="rounded-xl border border-green-200 bg-green-50 px-5 py-4 text-sm font-semibold text-green-800" role="status">
                You are now logged in to the admin panel.
            </p>
        </div>
    <% } %>

    <!-- Hero -->
    <section class="bg-[#302820] px-6 py-16 text-center text-white md:py-20">

        <p class="text-sm font-bold uppercase tracking-[4px] text-[#f2a16f]">
            Our Collection
        </p>

        <h1 class="mt-4 text-4xl font-black md:text-6xl">
            Discover Your Next
            <span class="block font-serif italic text-[#f2a16f]">
                Favourite Book
            </span>
        </h1>

        <p class="mx-auto mt-5 max-w-2xl leading-7 text-white/65">
            Explore stories, knowledge and ideas selected for every kind of reader.
        </p>

        <a href="#books"
           class="mt-7 inline-block rounded-md bg-[#e77c45] px-7 py-3 font-bold text-white hover:bg-[#d96c36]">
            Explore Collection ↓
        </a>

    </section>

    <!-- Admin Actions -->
    <% if(isAdmin) { %>

        <section class="border-b border-[#e5ded2] bg-white px-6 py-5">

            <div class="mx-auto flex max-w-6xl flex-wrap justify-center gap-3">

                <a href="/books/new"
                   class="rounded-md bg-[#302820] px-6 py-3 text-sm font-bold text-white hover:bg-[#d96c36]">
                    + Add New Book
                </a>

                <a href="/admin/logout"
                   class="rounded-md border border-red-200 px-6 py-3 text-sm font-bold text-red-600 hover:bg-red-500 hover:text-white">
                    Logout
                </a>

            </div>

        </section>

    <% } %>

    <!-- Books -->
    <main id="books" class="mx-auto max-w-6xl px-6 py-14">

        <div class="mb-9 flex flex-wrap items-end justify-between gap-4">

            <div>
                <p class="text-sm font-bold uppercase tracking-[3px] text-[#d96c36]">
                    Handpicked For You
                </p>

                <h2 class="mt-2 text-3xl font-black md:text-4xl">
                    Available Books
                </h2>
            </div>

            <a href="/categories"
               class="font-semibold text-[#d96c36] hover:underline">
                Browse Categories →
            </a>

        </div>

        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">

            <% books.forEach(book => { %>

                <article class="group flex flex-col overflow-hidden rounded-xl border border-[#e8dfd2] bg-white transition duration-300 hover:-translate-y-1 hover:shadow-xl">

                    <!-- Book Image -->
                    <div class="book-cover-frame m-3 mb-0 overflow-hidden rounded-lg">

                        <% if(book.image || book.imageUrl) { %>

                            <img
                                src="<%= book.image || book.imageUrl %>"
                                alt="<%= book.title %> cover"
                                class="book-cover-image"
                                loading="lazy"
                                onerror="this.hidden=true; this.nextElementSibling.hidden=false;">

                            <div class="book-cover-fallback" hidden aria-hidden="true">
                                <span class="text-5xl">📚</span>
                                <span class="text-sm">Cover unavailable</span>
                            </div>

                        <% } else { %>

                            <div class="book-cover-fallback">
                                <span class="text-5xl">📚</span>
                                <p class="mt-3 text-sm text-[#777168]">Book Cover</p>
                            </div>

                        <% } %>

                        <span class="absolute right-3 top-3 rounded bg-white px-3 py-1 text-xs font-bold text-[#d96c36] shadow">
                            BOOK
                        </span>

                    </div>

                    <!-- Book Details -->
                    <div class="flex flex-1 flex-col p-5">

                        <span class="mb-3 w-fit rounded-full bg-[#faf0e5] px-3 py-1 text-xs font-semibold text-[#b95024]">
                            <%= book.category %>
                        </span>

                        <h3 class="line-clamp-2 text-xl font-black leading-7">
                            <%= book.title %>
                        </h3>

                        <p class="mt-2 text-sm text-[#777168]">
                            By <%= book.author %>
                        </p>

                        <div class="mt-5 flex items-center justify-between border-t border-[#eee5d8] pt-4">

                            <span class="text-sm text-[#777168]">Price</span>

                            <span class="text-2xl font-black text-[#d96c36]">
                                ₹<%= book.price %>
                            </span>

                        </div>

                        <% if (!isAdmin) { %>
                            <!-- Purchase Buttons -->
                            <div class="mt-5 grid grid-cols-2 gap-3">

                            <button
                                type="button"
                                class="add-cart-btn rounded-md border border-[#d96c36] px-3 py-3 text-sm font-bold text-[#b95024] transition hover:bg-[#faf0e5]"
                                data-id="<%= book._id %>"
                                data-title="<%= book.title %>"
                                data-price="<%= book.price %>"
                                data-image="<%= book.image || book.imageUrl || '' %>"
                                data-author="<%= book.author %>">

                                + Add to Cart

                            </button>

                            <button
                                type="button"
                                class="buy-now-btn rounded-md bg-[#d96c36] px-3 py-3 text-sm font-bold text-white transition hover:bg-[#b95024]"
                                data-id="<%= book._id %>"
                                data-title="<%= book.title %>"
                                data-price="<%= book.price %>"
                                data-image="<%= book.image || book.imageUrl || '' %>"
                                data-author="<%= book.author %>">
                                Buy Now →
                            </button>

                            </div>
                        <% } %>

                        <!-- Admin Buttons -->
                        <% if(isAdmin) { %>

                            <div class="mt-5 flex gap-3 border-t border-[#eee5d8] pt-4">

                                <form action="/books/delete/<%= book._id %>"
                                      method="POST"
                                      class="flex-1"
                                      onsubmit="return confirm('Are you sure you want to delete this book?')">

                                    <button type="submit"
                                            class="w-full rounded-md border border-red-200 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-500 hover:text-white">
                                        Delete
                                    </button>

                                </form>

                                <form action="/books/edit/<%= book._id %>"
                                      method="GET"
                                      class="flex-1">

                                    <button type="submit"
                                            class="w-full rounded-md bg-[#302820] px-3 py-2 text-sm font-semibold text-white hover:bg-[#554536]">
                                        Edit
                                    </button>

                                </form>

                            </div>

                        <% } %>

                    </div>

                </article>

            <% }) %>

        </div>

        <% if(books.length === 0) { %>

            <div class="py-16 text-center">
                <p class="text-5xl">📚</p>
                <h3 class="mt-4 text-2xl font-bold">No books available yet</h3>
                <p class="mt-2 text-[#777168]">Please check back later for new books.</p>
            </div>

        <% } %>

    </main>

    <!-- Bottom CTA -->
    <section class="px-6 pb-16">

        <div class="mx-auto max-w-6xl rounded-xl bg-[#eee5d8] px-6 py-12 text-center md:px-12">

            <p class="text-sm font-bold uppercase tracking-[3px] text-[#d96c36]">
                Your Next Chapter
            </p>

            <h2 class="mt-3 text-3xl font-black md:text-4xl">
                A Great Book Is Always Worth It.
            </h2>

            <p class="mx-auto mt-4 max-w-xl leading-7 text-[#777168]">
                Discover a new perspective, explore a new world,
                and find your next favourite read.
            </p>

            <a href="/categories"
               class="mt-7 inline-block rounded-md bg-[#302820] px-7 py-3 font-bold text-white hover:bg-[#d96c36]">
                Explore Categories →
            </a>

        </div>

    </section>

    <!-- Footer -->
    <footer class="bg-[#302820] px-6 py-8 text-center text-white">

        <h3 class="text-xl font-black">
            <span class="font-serif italic text-[#f2a16f]">Bookholic</span>
        </h3>

        <p class="mt-3 text-sm text-white/60">
            Read. Discover. Repeat. © Bookholic
        </p>

    </footer>

    <!-- Cart Logic -->
    <script>
        function getCart() {
            try {
                const cart = JSON.parse(localStorage.getItem('bookCart') || '[]');
                return Array.isArray(cart) ? cart : [];
            } catch (error) {
                console.error('Unable to read cart:', error);
                return [];
            }
        }

        document.querySelectorAll('.add-cart-btn').forEach(button => {
            button.addEventListener('click', () => {
                const book = {
                    id: button.dataset.id,
                    title: button.dataset.title,
                    price: Number(button.dataset.price),
                    image: button.dataset.image,
                    author: button.dataset.author,
                    quantity: 1
                };

                const cart = getCart();
                const existingBook = cart.find(item => item.id === book.id);

                if (existingBook) {
                    existingBook.quantity += 1;
                } else {
                    cart.push(book);
                }

                localStorage.setItem('bookCart', JSON.stringify(cart));
                window.dispatchEvent(new Event('cartUpdated'));

                const originalText = button.textContent;
                button.textContent = '✓ Added to Cart';
                button.classList.add('bg-green-50', 'text-green-700');

                setTimeout(() => {
                    button.textContent = originalText;
                    button.classList.remove('bg-green-50', 'text-green-700');
                }, 1200);
            });
        });

        document.querySelectorAll('.buy-now-btn').forEach(button => {
            button.addEventListener('click', () => {
                const book = {
                    id: button.dataset.id,
                    title: button.dataset.title,
                    price: Number(button.dataset.price),
                    image: button.dataset.image,
                    author: button.dataset.author,
                    quantity: 1
                };
                const cart = getCart();
                const existingBook = cart.find(item => item.id === book.id);

                if (existingBook) {
                    existingBook.quantity += 1;
                } else {
                    cart.push(book);
                }

                localStorage.setItem('bookCart', JSON.stringify(cart));
                window.dispatchEvent(new Event('cartUpdated'));
                window.location.assign('/cart');
            });
        });

    </script>

</body>
</html>
