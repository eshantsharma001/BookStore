<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add New Book | Bookholic</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="/storefront.css">
</head>

<body class="store-ui min-h-screen bg-[#faf7f0] text-[#29251f] antialiased">

    <%- include('includes/nav.ejs') %>

    <!-- Page Header -->
    <section class="bg-[#302820] px-6 py-12 text-center text-white">

        <p class="text-sm font-bold uppercase tracking-[4px] text-[#f2a16f]">
            Book Management
        </p>

        <h1 class="mt-3 text-4xl font-black md:text-5xl">
            Add a New
            <span class="font-serif italic text-[#f2a16f]">Book.</span>
        </h1>

        <p class="mx-auto mt-4 max-w-xl text-sm leading-7 text-white/65">
            Expand your collection by adding a new story
            for readers to discover.
        </p>

    </section>

    <!-- Form Section -->
    <main class="px-6 py-12 md:py-16">

        <div class="mx-auto grid max-w-5xl items-start gap-10 md:grid-cols-5">

            <!-- Left Information -->
            <aside class="md:col-span-2">

                <div class="rounded-xl bg-[#eee5d8] p-7 md:p-8">

                    <span class="text-4xl">📚</span>

                    <p class="mt-6 text-sm font-bold uppercase tracking-[3px] text-[#d96c36]">
                        Admin Panel
                    </p>

                    <h2 class="mt-3 text-3xl font-black leading-tight">
                        Every Book Has a Story.
                    </h2>

                    <p class="mt-4 text-sm leading-7 text-[#777168]">
                        Add the book details carefully so readers can
                        discover the right title, learn about its author
                        and explore your collection.
                    </p>

                    <div class="mt-7 space-y-4 border-t border-[#d9cbbb] pt-6">

                        <div class="flex items-center gap-3">
                            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-white">
                                ✓
                            </span>

                            <p class="text-sm font-semibold">
                                Enter book information
                            </p>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-white">
                                ✓
                            </span>

                            <p class="text-sm font-semibold">
                                Set the selling price
                            </p>
                        </div>

                        <div class="flex items-center gap-3">
                            <span class="flex h-9 w-9 items-center justify-center rounded-md bg-white">
                                ✓
                            </span>

                            <p class="text-sm font-semibold">
                                Upload a book cover
                            </p>
                        </div>

                    </div>

                    <a href="/books"
                       class="mt-8 inline-block font-bold text-[#b95024] hover:underline">
                        ← Back to All Books
                    </a>

                </div>

            </aside>

            <!-- Add Book Form -->
            <section class="overflow-hidden rounded-xl border border-[#e8dfd2] bg-white shadow-sm md:col-span-3">

                <div class="h-1.5 bg-[#d96c36]"></div>

                <div class="p-6 md:p-9">

                    <div class="mb-8 border-b border-[#eee5d8] pb-5">

                        <h2 class="text-2xl font-black">
                            Book Details
                        </h2>

                        <p class="mt-2 text-sm text-[#777168]">
                            Fill in the information below.
                        </p>

                    </div>

                    <% if (formError) { %>
                        <p class="mb-5 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm font-semibold text-amber-800" role="alert">
                            Please choose a cover image before adding the book.
                        </p>
                    <% } %>

                    <form action="/books" method="post" enctype="multipart/form-data">

                        <!-- Title -->
                        <div class="mb-5">

                            <label for="title" class="mb-2 block text-sm font-bold">
                                Book Title
                            </label>

                            <input
                                id="title"
                                type="text"
                                name="title"
                                required
                                placeholder="e.g. The Art of Reading"
                                class="w-full rounded-md border border-[#e5ded2] bg-[#faf7f0] px-4 py-3.5 text-sm outline-none transition placeholder:text-[#aaa197] focus:border-[#d96c36] focus:bg-white focus:ring-2 focus:ring-[#d96c36]/10"
                            >

                        </div>

                        <!-- Author -->
                        <div class="mb-5">

                            <label for="author" class="mb-2 block text-sm font-bold">
                                Author Name
                            </label>

                            <input
                                id="author"
                                type="text"
                                name="author"
                                required
                                placeholder="Enter author's name"
                                class="w-full rounded-md border border-[#e5ded2] bg-[#faf7f0] px-4 py-3.5 text-sm outline-none transition placeholder:text-[#aaa197] focus:border-[#d96c36] focus:bg-white focus:ring-2 focus:ring-[#d96c36]/10"
                            >

                        </div>

                        <!-- Price and Category -->
                        <div class="mb-5 grid gap-5 sm:grid-cols-2">

                            <div>

                                <label for="price" class="mb-2 block text-sm font-bold">
                                    Price (₹)
                                </label>

                                <input
                                    id="price"
                                    type="number"
                                    name="price"
                                    min="0"
                                    step="0.01"
                                    required
                                    placeholder="e.g. 499"
                                    class="w-full rounded-md border border-[#e5ded2] bg-[#faf7f0] px-4 py-3.5 text-sm outline-none transition placeholder:text-[#aaa197] focus:border-[#d96c36] focus:bg-white focus:ring-2 focus:ring-[#d96c36]/10"
                                >

                            </div>

                            <div>

                                <label for="category" class="mb-2 block text-sm font-bold">
                                    Category
                                </label>

                                <input
                                    id="category"
                                    type="text"
                                    name="category"
                                    required
                                    placeholder="e.g. Fiction"
                                    class="w-full rounded-md border border-[#e5ded2] bg-[#faf7f0] px-4 py-3.5 text-sm outline-none transition placeholder:text-[#aaa197] focus:border-[#d96c36] focus:bg-white focus:ring-2 focus:ring-[#d96c36]/10"
                                >

                            </div>

                        </div>

                        <!-- Image Upload -->
                        <div class="mb-7">

                            <label for="img" class="mb-2 block text-sm font-bold">
                                Book Cover Image
                            </label>

                            <label for="img"
                                   class="flex cursor-pointer flex-col items-center justify-center rounded-lg border-2 border-dashed border-[#dfcbb8] bg-[#faf7f0] px-5 py-8 text-center transition hover:border-[#d96c36] hover:bg-[#faf0e5]">

                                <span class="text-3xl">🖼️</span>

                                <span class="mt-3 text-sm font-bold">
                                    Choose a cover image
                                </span>

                                <span class="mt-1 text-xs text-[#777168]">
                                    Select an image from your device
                                </span>

                                <span id="fileName" class="mt-3 break-all text-xs font-semibold text-[#b95024]">
                                    No file selected
                                </span>

                                <input
                                    id="img"
                                    type="file"
                                    name="img"
                                    accept="image/*"
                                    required
                                    class="sr-only"
                                >

                            </label>

                        </div>

                        <!-- Submit -->
                        <button
                            type="submit"
                            class="w-full rounded-md bg-[#d96c36] px-6 py-3.5 font-bold text-white transition hover:bg-[#b95024] focus:outline-none focus:ring-4 focus:ring-[#d96c36]/20">

                            + Add Book to Collection

                        </button>

                    </form>

                    <p class="mt-5 text-center text-xs leading-6 text-[#999084]">
                        Bookholic · Book Management
                    </p>

                </div>

            </section>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-[#302820] px-6 py-8 text-center text-white">

        <h3 class="text-xl font-black">
            <span class="font-serif italic text-[#f2a16f]">Bookholic</span>
        </h3>

        <p class="mt-3 text-sm text-white/60">
            Read. Discover. Repeat. © Bookholic
        </p>

    </footer>

    <!-- Selected File Name -->
    <script>
        const imageInput = document.getElementById('img');
        const fileName = document.getElementById('fileName');

        imageInput.addEventListener('change', function () {
            fileName.textContent = this.files.length
                ? this.files[0].name
                : 'No file selected';
        });
    </script>

</body>
</html>
